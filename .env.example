# Arbor server configuration. Copy to .env and fill in what you use; .env is git-ignored.
# Every value here stays on the API server. The web app and extension never receive provider keys.
# Arbor runs entirely free by default: a local model, local PostgreSQL and free search sources.
# Hosted providers below are optional; leave them empty to keep everything free and on this machine.

PORT=8787

# --- Local model (free, default) ---------------------------------------------
# `npm run dev` starts Arbor's local model server and downloads the model on first run (~2.5 GB).
# Any GGUF model works, e.g. hf:Qwen/Qwen3-8B-GGUF:Q4_K_M for better answers if you have 8 GB of GPU memory free.
LOCAL_MODEL=
# Point at Ollama (http://127.0.0.1:11434/v1), LM Studio or another OpenAI-compatible local server instead.
LOCAL_LLM_URL=
# Model names to request from that server (Ollama needs real names, e.g. qwen3:8b). Built-in server: leave empty.
LOCAL_MODEL_ID=
LOCAL_THINKING_MODEL_ID=
# Set to off to disable the local model.
LOCAL_LLM=
# Tokens of context per request (default 16384) and parallel requests (default 2).
LOCAL_CONTEXT_SIZE=
LOCAL_PARALLEL=

# --- Hosted AI providers (optional, paid) ------------------------------------
# A model becomes available only when its provider has a key AND its model ID variable is set.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_REASONING_MODEL=
# Optional, for an OpenAI-compatible proxy. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_MODEL=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek's general model and reasoning model (e.g. deepseek-chat and deepseek-reasoner).
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_REASONING_MODEL=
# Optional, for a DeepSeek-compatible gateway. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Google Gemini — https://aistudio.google.com/apikey (GEMINI_API_KEY is accepted too)
GOOGLE_API_KEY=
GOOGLE_FAST_MODEL=
GOOGLE_MODEL=

# --- Search -------------------------------------------------------------------
# Wikipedia, OpenAlex and the other free sources work without any key.
# Optional: a contact email sent to OpenAlex and Wikipedia, as their polite-use policies request.
ARBOR_CONTACT_EMAIL=
# Optional, self-hosted metasearch (SearXNG, free and open source) for general web results.
SEARXNG_URL=
# Optional, paid: Brave Search API.
BRAVE_SEARCH_API_KEY=

# --- Database -----------------------------------------------------------------
# Leave empty to use the local PostgreSQL that `npm run dev` manages in data/postgres.
DATABASE_URL=

# --- Optional -----------------------------------------------------------------
# Model registry file. Defaults to config/models.example.json.
MODEL_CONFIG_PATH=
# Milliseconds without any data from a provider before the request times out. Defaults to 180000.
PROVIDER_TIMEOUT_MS=
# JSON array limiting which providers may receive data, e.g. ["local"]. Default: all configured.
ALLOWED_PROVIDERS=
