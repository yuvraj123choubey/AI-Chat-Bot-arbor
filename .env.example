# Arbor server configuration. Copy to .env and fill in what you use; .env is git-ignored.
# Every value here stays on the API server. The web app and extension never receive provider keys.
# Restart `npm run dev` after editing (the API also restarts itself when .env changes).

PORT=8787

# --- AI providers -------------------------------------------------------------
# A model becomes available only when its provider has a key AND its model ID variable is set.
# Model IDs change over time: copy them from each provider's current model list.

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_FAST_MODEL=
OPENAI_REASONING_MODEL=
# Optional, for an OpenAI-compatible proxy. Defaults to https://api.openai.com/v1
OPENAI_BASE_URL=

# Anthropic (Claude) — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
ANTHROPIC_FAST_MODEL=
ANTHROPIC_MODEL=

# DeepSeek — https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
# DeepSeek's general model and reasoning model (e.g. deepseek-chat and deepseek-reasoner).
DEEPSEEK_CHAT_MODEL=
DEEPSEEK_REASONING_MODEL=
# Optional, for a DeepSeek-compatible gateway. Defaults to https://api.deepseek.com
DEEPSEEK_BASE_URL=

# Google Gemini — https://aistudio.google.com/apikey (GEMINI_API_KEY is accepted too)
GOOGLE_API_KEY=
GOOGLE_FAST_MODEL=
GOOGLE_MODEL=

# --- Search (used by research tasks, not by Ask Arbor chat yet) ----------------
BRAVE_SEARCH_API_KEY=

# --- Optional -----------------------------------------------------------------
# Model registry file. Defaults to config/models.example.json.
MODEL_CONFIG_PATH=
# Milliseconds without any data from a provider before the request times out. Defaults to 180000.
PROVIDER_TIMEOUT_MS=
# JSON array limiting which providers may receive data, e.g. ["openai","deepseek"]. Default: all configured.
ALLOWED_PROVIDERS=
