{
  "name": "atlas-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n db,llm,api,web \"npm:dev:db\" \"npm:dev:llm\" \"npm:dev:api\" \"npm:dev:web\"",
    "dev:db": "tsx scripts/db.ts start",
    "dev:api": "tsx watch --include .env --include config/models.example.json apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "start": "tsx scripts/db.ts migrate && tsx apps/api/src/server.ts",
    "db:migrate": "tsx scripts/db.ts migrate",
    "db:stop": "tsx scripts/db.ts stop",
    "db:generate": "prisma generate",
    "postinstall": "prisma generate",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "node --experimental-transform-types --test --test-timeout=60000 \"packages/*/test/*.test.ts\" \"apps/*/test/*.test.ts\"",
    "check:search": "tsx scripts/check-search.ts",
    "dev:llm": "tsx apps/local-llm/src/server.ts",
    "eval:agent": "tsx packages/code/eval/run.ts",
    "eval:study": "tsx packages/study/eval/run.ts"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@huggingface/transformers": "^4.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mozilla/readability": "^0.6.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@tesseract.js-data/eng": "^1.0.0",
    "acorn": "^8.19.0",
    "busboy": "^1.6.0",
    "codemirror": "^6.0.2",
    "embedded-postgres": "^18.4.0-beta.17",
    "linkedom": "^0.18.13",
    "mammoth": "^1.13.0",
    "node-llama-cpp": "^3.22.1",
    "pdfjs-dist": "^6.3.289",
    "pg": "^8.23.1",
    "playwright-core": "^1.63.0",
    "prisma": "^7.10.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sharp": "^0.35.5",
    "tesseract.js": "^7.0.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/busboy": "^1.5.4",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.13.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.0"
  },
  "allowScripts": {
    "@prisma/engines@7.10.0": true
  }
}
